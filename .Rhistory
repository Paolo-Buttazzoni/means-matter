library(plyr)    # for geom_split_violin's arrange() call
# ---- Load helper functions (read_qualtrics) and the split-violin geom ----
source("r/functions.R")   # must contain read_qualtrics & geom_split_violin
# ---- Load Study 3a objects needed for the combined figure ----
add_mod_study3a <- readRDS("data/study3a/add_mod_study3a.rds")
dtP5_study3a    <- readRDS("data/study3a/dtP5_study3a.rds")
# Study 3a: Pre-registered factorial experiment
