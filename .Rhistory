library(tidyverse)
library(readr)
# 'Do means matter morally?' study 2b
# Function to Read and Prepare Data
read_qualtrics <- function(filename) {
headers <- read_csv(filename, col_names = FALSE, n_max = 1) %>% as.character()
data <- read_csv(filename, skip = 3, col_names = FALSE)
colnames(data) <- headers
return(data)
}
# Load Data
mm2b_raw <- read_qualtrics('study2b/data/study2b_anon.csv')
mm2b_demog = mm2b_raw %>%
select(Progress, Duration = `Duration (in seconds)`, RecordedDate, anon_id, Condition, Scenario,
age:politics_2, Comp1 = Q544, Comp2 = Q545, choice, rating = rating_1) %>%
filter(!is.na(anon_id), Progress == 100, !is.na(choice))
mm2b_demog %>%
select(anon_id) %>%
distinct()
glimpse(mm2b_demog)
# Mean & SD for Age
mm2b_demog %>%
summarise(
mean_age = mean(age, na.rm = TRUE),
sd_age   = sd(age, na.rm = TRUE),
n        = n()
)
# Gender
mm2a %>%
count(gender) %>%
mutate(prop = n / sum(n))
# Gender
mm2b_demog %>%
count(gender) %>%
mutate(prop = n / sum(n))
# Religiosity
mm2b_demog %>%
count(Religiosity) %>%
mutate(prop = n / sum(n))
# Religiosity
mm2b_demog %>%
count(religiosity_1) %>%
mutate(prop = n / sum(n))
mm2b_demog = mm2b_raw %>%
select(Progress, Duration = `Duration (in seconds)`, RecordedDate, anon_id, Condition, Scenario,
age:politics_2, Comp1 = Q544, Comp2 = Q545, choice, rating = rating_1) %>%
filter(!is.na(anon_id), Progress == 100, !is.na(choice)) %>%
mutate(
Conservatism = (politics_1 + politics_2) / 2
)
duplicate_anon_ids <- mm2b_demog %>%
group_by(anon_id) %>%
summarise(
n_rows = n(),
unique_participants = n_distinct(anon_id),  # Should always be 1 for same anon_id
.groups = 'drop'
) %>%
filter(n_rows > 1)  # Find anon_id that appear more than once
print(paste("Found", nrow(duplicate_anon_ids), "anon_id values that appear multiple times"))
print(duplicate_anon_ids %>% arrange(desc(n_rows)))
library(tidyverse)
library(readr)
# 'Do means matter morally?' study 2b
# Function to Read and Prepare Data
read_qualtrics <- function(filename) {
headers <- read_csv(filename, col_names = FALSE, n_max = 1) %>% as.character()
data <- read_csv(filename, skip = 3, col_names = FALSE)
colnames(data) <- headers
return(data)
}
# Load Data
mm2b_raw <- read_qualtrics('study2b/data/study2b_anon.csv')
mm2b_demog = mm2b_raw %>%
select(Progress, Duration = `Duration (in seconds)`, RecordedDate, anon_id, Condition, Scenario,
age:politics_2, Comp1 = Q544, Comp2 = Q545, choice, rating = rating_1) %>%
filter(!is.na(anon_id), Progress == 100, !is.na(choice)) %>%
mutate(
Conservatism = (politics_1 + politics_2) / 2
)
# Mean & SD for Age
mm2b_demog %>%
summarise(
mean_age = mean(age, na.rm = TRUE),
sd_age   = sd(age, na.rm = TRUE),
n        = n()
)
# Gender
mm2b_demog %>%
count(gender) %>%
mutate(prop = n / sum(n))
# Religiosity
mm2b_demog %>%
count(religiosity_1) %>%
mutate(prop = n / sum(n))
# Political
mm2b_demog %>%
count(Conservatism) %>%
mutate(prop = n / sum(n))
mm2a %>%
summarise(
n_below5 = sum(Conservatism < 5, na.rm = TRUE),
prop_below5 = mean(Conservatism < 5, na.rm = TRUE),
n_total = sum(!is.na(Conservatism)))
