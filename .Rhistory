pivot_longer(-anon_id, names_to = "key", values_to = "factorName", values_drop_na = TRUE) %>%
mutate(
scenario = str_to_upper(str_sub(key, 1, 3)),
item     = str_sub(key, 4, -1)
) %>%
filter(!is.na(anon_id)) %>%
group_by(anon_id, scenario, item) %>%
summarise(factorName = first(factorName), .groups = "drop") %>%   # handle duplicates safely
pivot_wider(names_from = item, values_from = factorName, id_cols = c(anon_id, scenario)) %>%
mutate(scenario = as.factor(scenario))
# 2.4 Cheating & fairness
cheat_b <- study3b %>%
select(matches("^(COG|COS|MEM|MOOD|PHY)_(FAIR|CHEAT)_[0-9]$"), anon_id) %>%
mutate(across(-anon_id, as.numeric)) %>%
pivot_longer(-anon_id, names_to = "key", values_to = "resp", values_drop_na = TRUE) %>%
mutate(
scenario = str_sub(key, 1, 3),
item     = str_extract(key, "FAIR|CHEAT")
) %>%
group_by(anon_id, scenario, item) %>%
summarise(resp = mean(resp, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = item, values_from = resp, id_cols = c(anon_id, scenario)) %>%
select(anon_id, scenario, fair = FAIR, cheat = CHEAT)
# 2.5 Safety & naturalness
safety_b <- study3b %>%
select(matches("^(COG|COS|MEM|MOOD|PHY)_(SAFE|NAT)_[0-9]$"), anon_id) %>%
mutate(across(-anon_id, as.numeric)) %>%
pivot_longer(-anon_id, names_to = "key", values_to = "resp", values_drop_na = TRUE) %>%
mutate(
scenario = str_sub(key, 1, 3),
item     = str_extract(key, "SAFE|NAT")
) %>%
group_by(anon_id, scenario, item) %>%
summarise(resp = mean(resp, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = item, values_from = resp, id_cols = c(anon_id, scenario)) %>%
select(anon_id, scenario, safe = SAFE, natural = NAT)
# 2.6 Merge all components & set reference levels
dtP5b <- full_join(mj_b, mc_b, by = c("anon_id", "scenario"))
dtP5b <- left_join(dtP5b, ivFactors_b, by = c("anon_id", "scenario"))
dtP5b <- left_join(dtP5b, cheat_b, by = c("anon_id", "scenario"))
dtP5b <- left_join(dtP5b, safety_b, by = c("anon_id", "scenario"))
dtP5b <- dtP5b %>%
mutate(
Internal  = relevel(factor(Internal),  ref = "External"),
Reward    = relevel(factor(Reward),    ref = "Low"),
Effort    = relevel(factor(Effort),    ref = "High"),
Normality = relevel(factor(Normality), ref = "High")
)
# ============================================================================
# 3. Analyses
# ============================================================================
# ---- 3.1 Manipulation checks (semi‑standardised) ----
mcheck_body_b <- lmer(scale(body) ~ Internal + (1 | scenario), data = dtP5b)
mcheck_eff_b  <- lmer(scale(effort) ~ Effort + (1 | scenario), data = dtP5b)
mcheck_norm_b <- lmer(scale(normality) ~ Normality + (1 | scenario), data = dtP5b)
mcheck_rew_b  <- lmer(scale(reward) ~ Reward + (1 | scenario), data = dtP5b)
mc_table_b <- bind_rows(
summ(mcheck_body_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) != "(Intercept)") %>% mutate(check = "Body envelope"),
summ(mcheck_eff_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) != "(Intercept)") %>% mutate(check = "Effort"),
summ(mcheck_norm_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) != "(Intercept)") %>% mutate(check = "Normality"),
summ(mcheck_rew_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) != "(Intercept)") %>% mutate(check = "Reward")
) %>%
select(check, Est., `t val.`, p) %>%
rename(beta_std = Est., t_value = `t val.`, p_value = p)
cat("\n--- Study 3b: Manipulation checks ---\n")
print(mc_table_b)
# ---- 3.2 Additive model (main effects) ----
add_mod_b <- lmer(scale(resp) ~ Internal + Normality + Effort + Reward +
(1 | scenario), data = dtP5b)
cat("\n--- Study 3b: Additive model ---\n")
print(summ(add_mod_b, digits = 3, confint = TRUE))
# ---- 3.3 Continuous perceptions as predictors (standardised) ----
cont_mod_std_b <- lmer(scale(resp) ~ scale(body) + scale(normality) +
scale(effort) + scale(reward) + (1 | scenario),
data = dtP5b)
cat("\n--- Study 3b: Continuous perception model (standardised) ---\n")
print(summ(cont_mod_std_b, digits = 3, confint = TRUE))
# ---- 3.4 Exploratory: Internal → perceived effort / reward / cheating / safety ----
eff_int_b   <- lmer(scale(effort) ~ Internal + Normality + Effort + Reward + (1 | scenario), data = dtP5b)
rew_int_b   <- lmer(scale(reward) ~ Internal + Normality + Effort + Reward + (1 | scenario), data = dtP5b)
cheat_int_b <- lmer(scale(cheat)  ~ Internal + Normality + Effort + Reward + (1 | scenario), data = dtP5b)
safe_int_b  <- lmer(scale(safe)   ~ Internal + Normality + Effort + Reward + (1 | scenario), data = dtP5b)
cat("\n--- Study 3b: Internal → perceived effort ---\n")
print(summ(eff_int_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) == "InternalInternal"))
cat("\n--- Study 3b: Internal → perceived reward ---\n")
print(summ(rew_int_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) == "InternalInternal"))
cat("\n--- Study 3b: Internal → perceived cheating ---\n")
print(summ(cheat_int_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) == "InternalInternal"))
cat("\n--- Study 3b: Internal → perceived safety ---\n")
print(summ(safe_int_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) == "InternalInternal"))
# ============================================================================
# 4. Combined Figure 6: additive model coefficients (Study 3a vs 3b)
# ============================================================================
# Extract grand effects from the loaded Study 3a model
grand_a <- summ(add_mod_study3a, confint = TRUE, digits = 3)$coeftable %>%
as.data.frame() %>%
rownames_to_column("term") %>%
filter(term != "(Intercept)") %>%
rename(estimate = Est., low_ci = `2.5%`, hi_ci = `97.5%`) %>%
mutate(
effect = case_when(
term == "InternalInternal" ~ "Internal",
term == "NormalityLow"     ~ "Normality",
term == "EffortLow"        ~ "Effort",
term == "RewardHigh"       ~ "Reward"
),
experiment = "Study 3a"
)
# Extract grand effects from Study 3b
grand_b <- summ(add_mod_b, confint = TRUE, digits = 3)$coeftable %>%
as.data.frame() %>%
rownames_to_column("term") %>%
filter(term != "(Intercept)") %>%
rename(estimate = Est., low_ci = `2.5%`, hi_ci = `97.5%`) %>%
mutate(
effect = case_when(
term == "InternalInternal" ~ "Internal",
term == "NormalityLow"     ~ "Normality",
term == "EffortLow"        ~ "Effort",
term == "RewardHigh"       ~ "Reward"
),
experiment = "Study 3b"
)
# Combine and set factor order
grand_all <- bind_rows(grand_a, grand_b) %>%
mutate(effect = factor(effect, levels = c("Internal", "Normality", "Effort", "Reward")))
# Plot (identical style to manuscript Figure 6)
fig6 <- ggplot(grand_all, aes(x = effect, y = estimate, color = experiment)) +
geom_hline(yintercept = 0, linetype = 2) +
geom_linerange(
aes(ymin = low_ci, ymax = hi_ci),
position = position_dodge(width = 0.4),
linewidth = 1
) +
geom_point(
position = position_dodge(width = 0.4),
size = 3, shape = 21, fill = "white"
) +
coord_flip() +
scale_color_manual(values = c("Study 3a" = "skyblue", "Study 3b" = "brown")) +
labs(
y = "Semi‑standardized regression coefficient (95% CI)",
x = NULL
) +
theme_classic(base_size = 12) +
theme(legend.position = "top")
print(fig6)
# Optionally save the figure
# ggsave("Figures/Figure6_combined.png", fig6, width = 10, height = 6, dpi = 300)
# Study 3b: Strict-exclusion replication
# Load packages
library(tidyverse)
library(lme4)
library(lmerTest)
library(jtools)
library(emmeans)
# Load raw data
source("r/functions.R")
add_mod <- readRDS("data/study2a/add_mod_study3a.rds")
study3b <- read_qualtrics("data/study3b/study3b_anon.csv")
# Basic demographic summary
demo <- study3b %>%
distinct(anon_id, .keep_all = TRUE) %>%
mutate(
gender_label = case_when(
gender == 21 ~ "Male",
gender == 22 ~ "Female",
TRUE ~ NA_character_
)
) %>%
summarise(
n_participants = n(),
median_age = median(age, na.rm = TRUE),
prop_female = mean(gender_label == "Female", na.rm = TRUE)
)
print(demo)
# Moral judgment composite
mj_b <- study3b %>%
select(matches("^(COG|COS|MEM|MOOD|PHY)_MJ[1-3]_[0-9]$"), anon_id) %>%
mutate(across(-anon_id, as.numeric)) %>%
pivot_longer(-anon_id, names_to = "key", values_to = "resp", values_drop_na = TRUE) %>%
mutate(scenario = str_sub(key, 1, 3),
item     = str_sub(key, -5, -3)) %>%
group_by(anon_id, scenario, item) %>%
summarise(resp = mean(resp, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = item, values_from = resp, id_cols = c(anon_id, scenario)) %>%
mutate(resp = (MJ1 + MJ2 + (100 - MJ3)) / 3,
scenario = as.factor(scenario))
# Manipulation‑check ratings
mc_b <- study3b %>%
select(matches("^(COG|COS|MEM|MOOD|PHY)_(BE|NOR|EFF|REW)_[0-9]$"), anon_id) %>%
mutate(across(-anon_id, as.numeric)) %>%
pivot_longer(-anon_id, names_to = "key", values_to = "med", values_drop_na = TRUE) %>%
mutate(scenario = str_sub(key, 1, 3),
item     = str_extract(key, "BE|NOR|EFF|REW")) %>%
group_by(anon_id, scenario, item) %>%
summarise(med = mean(med, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = item, values_from = med, id_cols = c(anon_id, scenario)) %>%
rename(normality = NOR, effort = EFF, reward = REW, body = BE) %>%
mutate(scenario = as.factor(scenario))
# Experimental factors
ivFactors_b <- study3b %>%
select(matches("Internal|Effort|Reward|Normality", ignore.case = FALSE), anon_id) %>%
pivot_longer(-anon_id, names_to = "key", values_to = "factorName", values_drop_na = TRUE) %>%
mutate(
scenario = str_to_upper(str_sub(key, 1, 3)),
item     = str_sub(key, 4, -1)
) %>%
filter(!is.na(anon_id)) %>%
group_by(anon_id, scenario, item) %>%
summarise(factorName = first(factorName), .groups = "drop") %>%   # take first label
pivot_wider(names_from = item, values_from = factorName, id_cols = c(anon_id, scenario)) %>%
mutate(scenario = as.factor(scenario))
# Cheating & fairness (same extraction as Study 3a)
cheat_b <- study3b %>%
select(matches("^(COG|COS|MEM|MOOD|PHY)_(FAIR|CHEAT)_[0-9]$"), anon_id) %>%
mutate(across(-anon_id, as.numeric)) %>%
pivot_longer(-anon_id, names_to = "key", values_to = "resp", values_drop_na = TRUE) %>%
mutate(
scenario = str_sub(key, 1, 3),
item     = str_extract(key, "FAIR|CHEAT")
) %>%
group_by(anon_id, scenario, item) %>%
summarise(resp = mean(resp, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = item, values_from = resp, id_cols = c(anon_id, scenario)) %>%
select(anon_id, scenario, fair = FAIR, cheat = CHEAT)
# Safety and naturalness (SAFE, NAT)
safety_b <- study3b %>%
select(matches("^(COG|COS|MEM|MOOD|PHY)_(SAFE|NAT)_[0-9]$"), anon_id) %>%
mutate(across(-anon_id, as.numeric)) %>%
pivot_longer(-anon_id, names_to = "key", values_to = "resp", values_drop_na = TRUE) %>%
mutate(
scenario = str_sub(key, 1, 3),
item     = str_extract(key, "SAFE|NAT")
) %>%
group_by(anon_id, scenario, item) %>%
summarise(resp = mean(resp, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = item, values_from = resp, id_cols = c(anon_id, scenario)) %>%
select(anon_id, scenario, safe = SAFE, natural = NAT)
# Merge and set reference levels
dtP5b <- full_join(mj_b, mc_b, by = c("anon_id", "scenario"))
dtP5b <- left_join(dtP5b, ivFactors_b, by = c("anon_id", "scenario"))
dtP5b <- left_join(dtP5b, cheat_b, by = c("anon_id", "scenario"))
dtP5b <- left_join(dtP5b, safety_b, by = c("anon_id", "scenario"))
dtP5b <- dtP5b %>%
mutate(
Internal  = relevel(factor(Internal),  ref = "External"),
Reward    = relevel(factor(Reward),    ref = "Low"),
Effort    = relevel(factor(Effort),    ref = "High"),
Normality = relevel(factor(Normality), ref = "High")
)
# ---- 2.1 Manipulation checks ----
mcheck_body_b <- lmer(scale(body) ~ Internal + (1 | scenario), data = dtP5b)
mcheck_eff_b  <- lmer(scale(effort) ~ Effort + (1 | scenario), data = dtP5b)
mcheck_norm_b <- lmer(scale(normality) ~ Normality + (1 | scenario), data = dtP5b)
mcheck_rew_b  <- lmer(scale(reward) ~ Reward + (1 | scenario), data = dtP5b)
mc_table_b <- bind_rows(
summ(mcheck_body_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) != "(Intercept)") %>% mutate(check = "Body envelope"),
summ(mcheck_eff_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) != "(Intercept)") %>% mutate(check = "Effort"),
summ(mcheck_norm_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) != "(Intercept)") %>% mutate(check = "Normality"),
summ(mcheck_rew_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) != "(Intercept)") %>% mutate(check = "Reward")
) %>%
select(check, Est., `t val.`, p) %>%
rename(beta_std = Est., t_value = `t val.`, p_value = p)
cat("\n--- Study 3b: Manipulation checks ---\n")
print(mc_table_b)
# ---- 2.2 Additive model (main effects) ----
add_mod_b <- lmer(scale(resp) ~ Internal + Normality + Effort + Reward +
(1 | scenario), data = dtP5b)
cat("\n--- Study 3b: Additive model ---\n")
print(summ(add_mod_b, digits = 3, confint = TRUE))
# ---- 2.3 Continuous perceptions (standardized) ----
cont_mod_std_b <- lmer(scale(resp) ~ scale(body) + scale(normality) +
scale(effort) + scale(reward) + (1 | scenario),
data = dtP5b)
cat("\n--- Study 3b: Continuous perception model ---\n")
print(summ(cont_mod_std_b, digits = 3, confint = TRUE))
# ---- 2.4 Exploratory: Internal → effort, reward, cheating, safety ----
# (You need cheating and safety columns; they exist as FAIR/CHEAT and SAFE)
eff_int_b <- lmer(scale(effort) ~ Internal + Normality + Effort + Reward +
(1 | scenario), data = dtP5b)
rew_int_b <- lmer(scale(reward) ~ Internal + Normality + Effort + Reward +
(1 | scenario), data = dtP5b)
cheat_int_b <- lmer(scale(cheat) ~ Internal + Normality + Effort + Reward +
(1 | scenario), data = dtP5b)
safe_int_b  <- lmer(scale(safe) ~ Internal + Normality + Effort + Reward +
(1 | scenario), data = dtP5b)
cat("\n--- Study 3b: Internal on perceived effort ---\n")
print(summ(eff_int_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) == "InternalInternal"))
cat("\n--- Study 3b: Internal on perceived reward ---\n")
print(summ(rew_int_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) == "InternalInternal"))
cat("\n--- Study 3b: Internal on perceived cheating ---\n")
print(summ(cheat_int_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) == "InternalInternal"))
cat("\n--- Study 3b: Internal on perceived safety ---\n")
print(summ(safe_int_b, digits = 3)$coeftable %>% as.data.frame() %>%
filter(row.names(.) == "InternalInternal"))
# Extract grand effects from Study 3a (you already have dtP5)
grand_a <- summ(add_mod, confint = TRUE, digits = 3)$coeftable %>%
as.data.frame() %>%
rownames_to_column("term") %>%
filter(term != "(Intercept)") %>%
rename(estimate = Est., low_ci = `2.5%`, hi_ci = `97.5%`) %>%
mutate(
effect = case_when(
term == "InternalInternal" ~ "Internal",
term == "NormalityLow"     ~ "Normality",
term == "EffortLow"        ~ "Effort",
term == "RewardHigh"       ~ "Reward"
),
experiment = "Study 3a"
)
# Extract grand effects from Study 3b
grand_b <- summ(add_mod_b, confint = TRUE, digits = 3)$coeftable %>%
as.data.frame() %>%
rownames_to_column("term") %>%
filter(term != "(Intercept)") %>%
rename(estimate = Est., low_ci = `2.5%`, hi_ci = `97.5%`) %>%
mutate(
effect = case_when(
term == "InternalInternal" ~ "Internal",
term == "NormalityLow"     ~ "Normality",
term == "EffortLow"        ~ "Effort",
term == "RewardHigh"       ~ "Reward"
),
experiment = "Study 3b"
)
grand_all <- bind_rows(grand_a, grand_b) %>%
mutate(effect = factor(effect, levels = c("Internal", "Normality", "Effort", "Reward")))
# Plot
ggplot(grand_all, aes(x = effect, y = estimate, color = experiment)) +
geom_hline(yintercept = 0, linetype = 2) +
geom_linerange(aes(ymin = low_ci, ymax = hi_ci),
position = position_dodge(width = 0.4), linewidth = 1) +
geom_point(position = position_dodge(width = 0.4), size = 3, shape = 21, fill = "white") +
coord_flip() +
scale_color_manual(values = c("Study 3a" = "skyblue", "Study 3b" = "brown")) +
labs(
y = "Semi‑standardized regression coefficient (95% CI)",
x = NULL
) +
theme_classic(base_size = 12) +
theme(legend.position = "top")
mj <- study3a %>%
select(matches("^(COG|COS|MEM|MOOD|PHY)_MJ[1-3]_[0-9]$"), anon_id) %>%
mutate(across(-anon_id, as.numeric)) %>%
pivot_longer(-anon_id, names_to = "key", values_to = "resp", values_drop_na = TRUE) %>%
mutate(
scenario = str_sub(key, 1, 3),
item = str_sub(key, -5, -3)) %>%
group_by(anon_id, scenario, item) %>%
summarise(resp = mean(resp, na.rm = TRUE), .groups = "drop") %>%
pivot_wider(names_from = item, values_from = resp, id_cols = c(anon_id, scenario)) %>%
mutate(resp = (MJ1 + MJ2 + (100 - MJ3)) / 3,
scenario = as.factor(scenario))
print(fig6)
