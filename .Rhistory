source("r/functions.R")
study3a <- read_qualtrics('data/study3a/study3a_anon.csv')
#Basic demographic summary
demo <- study3a %>%
distinct(anon_id, .keep_all = TRUE) %>%
mutate(
gender_label = case_when(
