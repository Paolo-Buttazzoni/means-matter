geom_vline(xintercept = -3.11, linetype = 2) +
geom_vline(xintercept = 32.4, linetype = 2) +
geom_jitter(width = 0.2, height = 0, alpha = 0.7) +
geom_smooth(method = "lm") +
theme_classic() +
ylim(0, 100) +
scale_color_brewer(palette = "Set2") +
labs(
