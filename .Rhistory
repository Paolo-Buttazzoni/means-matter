str(codes)
# This would error — c1resp isn't a standalone object in your environment
cohen_kappa <- psych::cohen.kappa(x = cbind(c1resp, c2resp))
cohen_kappa <- psych::cohen.kappa(x = cbind(codes$c1resp, codes$c2resp))
cohen_kappa
codes_final <- codes %>%
mutate(final_present = if_else(c1resp == 1 | c2resp == 1, 1, 0)) %>%
select(anon_id, category, final_present)
codes_final_AND <- codes %>%
mutate(final_present = if_else(c1resp == 1 & c2resp == 1, 1, 0)) %>%
select(anon_id, category, final_present)
codes_grouped_AND <- codes_final_AND %>%
left_join(mm2a %>% select(anon_id, Endorsement), by = "anon_id")
compute_rr("UTILITY", codes_grouped_AND)
