# 1. Add proportions within each endorsement group
gender_endorsement <- mm1 %>%
group_by(Endorsement, Gender) %>%
summarise(n = n(), .groups = 'drop') %>%
group_by(Endorsement) %>%
mutate(
total = sum(n),
proportion = n / total,
percentage = proportion * 100
)
print(gender_endorsement)
# 2. Create a contingency table for better visualization
cont_table <- xtabs(~ Gender + Endorsement, mm1)
print(cont_table)
t
t
# 3. Add row proportions to see distribution by gender
prop.table(cont_table, margin = 1)  # Proportions by row (Gender)
prop.table(cont_table, margin = 2)  # Proportions by column (Endorsement)
# 4. Chi-squared test as an alternative to Fisher's exact
chisq_test <- chisq.test(cont_table)
print(chisq_test)
