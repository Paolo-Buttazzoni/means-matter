fullrange = TRUE,
color = '#686868',
fill = '#686868',
linewidth = .4
) +
scale_alpha_manual(values = c(.4, .02), guide = "none") +
geom_point(data = mean_views,
shape = 21, size = 2, fill = 'white', stroke = .5,
