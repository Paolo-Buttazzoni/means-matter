library(epitools)
install.packages("epitools")
library(epitools)
compute_rr <- function(cat_name, data) {
sub <- data %>% filter(category == cat_name)
tab <- table(sub$Endorsement, sub$final_present)
# epitools expects columns ordered: outcome absent, outcome present
# and rows: reference group first, comparison group second
tab <- tab[, c("0", "1")]  # ensure Absent, Present column order
rr <- riskratio(tab, rev = "neither")  # check `rev` arg for correct reference level
print(cat_name)
print(rr)
return(rr)
}
compute_rr("utility", codes_grouped)
compute_rr <- function(cat_name, data) {
sub <- data %>% filter(category == cat_name)
tab <- table(sub$Endorsement, sub$final_present)
# epitools expects columns ordered: outcome absent, outcome present
# and rows: reference group first, comparison group second
tab <- tab[, c("0", "1")]  # ensure Absent, Present column order
rr <- riskratio(tab, rev = "neither")  # check `rev` arg for correct reference level
print(cat_name)
print(rr)
return(rr)
}
# Join to Endorsement group
codes_grouped <- codes_final %>%
left_join(mm2a %>% select(anon_id, Endorsement), by = "anon_id")
compute_rr("utility", codes_grouped)
# Does "utility" even exist as a category?
unique(codes_grouped$category)
# How many rows for utility, and what does final_present look like?
codes_grouped %>% filter(category == "utility") %>% count(final_present)
# What are the actual dimnames of the table?
sub <- codes_grouped %>% filter(category == "utility")
table(sub$Endorsement, sub$final_present)
compute_rr("UTILITY", codes_grouped)
compute_rr <- function(cat_name, data) {
sub <- data %>%
filter(category == cat_name) %>%
mutate(final_present = factor(final_present, levels = c(0, 1)),
Endorsement = factor(Endorsement))
if (nrow(sub) == 0) {
stop("No rows found for category: ", cat_name,
". Available categories: ", paste(unique(data$category), collapse = ", "))
}
tab <- table(sub$Endorsement, sub$final_present)
print(cat_name)
print(tab)
rr <- riskratio(tab, rev = "neither")
print(rr)
return(rr)
}
compute_rr("UTILITY", codes_grouped)
compute_rr("NOHARM", codes_grouped)
compute_rr("AUTONOMY", codes_grouped)
