distinct(anon_id, .keep_all = TRUE) %>%
mutate(
gender_label = case_when(
gender == 21 ~ "Male",
gender == 22 ~ "Female",
TRUE ~ NA_character_
)
) %>%
summarise(
n_participants = n(),
median_age = median(age, na.rm = TRUE),
prop_female = mean(gender_label == "Female", na.rm = TRUE)
)
